# Build context is the repository root (see ./Dockerfile). Exclude everything
# the image does not need, and in particular every .env file: server/credits
# holds .env.qa with a working Stripe test key, and it must never enter an
# image layer even though the build does not COPY it explicitly.
.git
.github
node_modules
**/node_modules

server/credits/data
server/credits/data-*
server/credits/*.sqlite*
server/credits/*.db
server/credits/.env
server/credits/.env.*
server/credits/test

dist
skill
skilltar.gz
.blender-smoke
*.log
