# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=https://credits.example.com
DATA_DIR=./data
LOG_LEVEL=info

# Set when the proxy is behind nginx / Cloudflare / a load balancer.
TRUST_PROXY=true
# Comma-free single origin, or * for any. Leave empty to disable CORS headers.
ALLOW_ORIGIN=https://skills.animotion.click

# ── Renderful (server-side only — never expose this key) ───────────────────
RENDERFUL_API_KEY=
RENDERFUL_BASE=https://api.renderful.ai/api/v1
MODELS_TTL_MS=900000
RENDERFUL_TIMEOUT_MS=30000

# ── Credit pricing ─────────────────────────────────────────────────────────
# 1 credit = $0.05 of raw Renderful spend. Quote a min–max range and reserve max.
CREDIT_USD=0.05
PRICING_BASIS=max
ALLOW_UNKNOWN_MODELS=false
# Optional override of the pack catalogue; must match the store.
# CREDIT_PACKS_JSON=[{"id":"starter","name":"Starter","credits":100,"priceCents":700}]

# ── License validation ─────────────────────────────────────────────────────
LICENSE_VALIDATE_URL=https://skills.animotion.click/api/license/validate
LICENSE_SKILL=agentic-web-developer
LICENSE_PLAN=pro
LICENSE_CACHE_MS=3600000
ALLOW_UNVERIFIED_LICENSES=false

# ── Stripe (card checkout + signed webhook) ────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://skills.animotion.click/credits?status=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://skills.animotion.click/credits?status=cancelled
STRIPE_TOLERANCE_SEC=300
# Used when Stripe is not configured; credits are then applied by the operator.
CHECKOUT_FALLBACK_URL=https://skills.animotion.click/credits

# ── Output files ───────────────────────────────────────────────────────────
# openssl rand -hex 32
FILE_SIGNING_SECRET=
FILE_URL_TTL_SEC=3600
MAX_OUTPUT_BYTES=209715200

# ── Operations ─────────────────────────────────────────────────────────────
# openssl rand -hex 32 — enables POST /v1/admin/grant
ADMIN_SECRET=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=60
MAX_BODY_BYTES=1048576

# ── Job poller ─────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=5000
POLL_MIN_INTERVAL_MS=2000
MAX_POLL_BATCH=5
TIMEOUT_IMAGE_MS=120000
TIMEOUT_AUDIO_MS=180000
TIMEOUT_3D_MS=300000
TIMEOUT_VIDEO_MS=600000
TIMEOUT_OTHER_MS=600000
